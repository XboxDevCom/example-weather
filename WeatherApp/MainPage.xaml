<Page
    x:Class="WeatherApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WeatherApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="True"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="48,24">
        <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Width="500" Spacing="20" Padding="20">

                <TextBlock Text="Wetter"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />

                <ComboBox x:Name="CitySelector"
                          Header="Stadt auswählen"
                          MinWidth="300"
                          MinHeight="48"
                          HorizontalAlignment="Stretch"
                          XYFocusDown="FetchButton" />

                <Button x:Name="FetchButton"
                        Content="Wetter abrufen"
                        Click="FetchButton_Click"
                        MinHeight="64"
                        MinWidth="200"
                        HorizontalAlignment="Stretch"
                        XYFocusUp="CitySelector" />

                <ProgressRing x:Name="LoadingIndicator"
                              IsActive="False"
                              Visibility="Collapsed"
                              Width="40"
                              Height="40"
                              HorizontalAlignment="Center" />

                <StackPanel x:Name="WeatherPanel"
                            Visibility="Collapsed"
                            Spacing="12"
                            Padding="20"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="8">

                    <TextBlock x:Name="CityText"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />

                    <TextBlock x:Name="IconText"
                               FontSize="72"
                               HorizontalAlignment="Center" />

                    <TextBlock x:Name="TempText"
                               FontSize="56"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />

                    <TextBlock x:Name="DescriptionText"
                               FontSize="24"
                               HorizontalAlignment="Center" />

                    <StackPanel Spacing="6" Padding="0,10,0,0">
                        <TextBlock x:Name="MinTempText" FontSize="18" />
                        <TextBlock x:Name="MaxTempText" FontSize="18" />
                        <TextBlock x:Name="HumidityText" FontSize="18" />
                        <TextBlock x:Name="WindText" FontSize="18" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Foreground="Red"
                           FontSize="18"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
